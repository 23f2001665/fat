// Workout tracker UI. All data shown here is composed by the Rust controller
// from actual database records; this file performs no calculations itself.

import { ScrollView } from "std-widgets.slint";

export struct WorkoutSetRow {
    sequence: int,
    title: string,
    detail: string,
    equipment: string,
    volume: string,
    extra: string,
    has_extra: bool,
}

export struct HistoryRow {
    date_key: string,
    date_label: string,
    title: string,
    detail: string,
    volume: string,
    set_count: int,
}

export struct PickerRow {
    id: int,
    title: string,
    subtitle: string,
    is_none: bool,
}

export struct LibraryRow {
    id: int,
    title: string,
    subtitle: string,
    badge: string,
    is_active: bool,
    can_toggle: bool,
    toggle_label: string,
}

export struct AssignmentRow {
    muscle_id: int,
    name: string,
    role: string,
    role_key: string,
}

export struct MuscleStatRow {
    name: string,
    sets: string,
    primary: string,
    secondary: string,
    total: string,
}

export struct NamedValueRow {
    label: string,
    value: string,
}

export struct ComparisonRow {
    label: string,
    current: string,
    delta: string,
    has_delta: bool,
    dates: string,
}

export struct MeasurementRow {
    title: string,
    detail: string,
    notes: string,
    has_notes: bool,
}

global Palette {
    in property <color> bg: #0e1116;
    in property <color> surface: #171c24;
    in property <color> surface-alt: #1f2631;
    in property <color> border: #2b3442;
    in property <color> text: #eef2f7;
    in property <color> muted: #93a1b5;
    in property <color> accent: #5eead4;
    in property <color> accent-soft: #143b38;
    in property <color> danger: #f87171;
    in property <color> danger-soft: #3a1a1e;
    in property <color> warning: #fbbf24;
}

component Card inherits Rectangle {
    background: Palette.surface;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.border;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 44px;
    border-radius: 10px;
    opacity: root.enabled ? 1 : 0.45;
    background: !root.enabled
        ? Palette.surface-alt
        : root.primary
            ? Palette.accent
            : root.danger
                ? Palette.danger-soft
                : Palette.surface-alt;
    border-width: 1px;
    border-color: root.primary
        ? Palette.accent
        : root.danger
            ? #7f2b34
            : Palette.border;

    body := Text {
        text: root.label;
        color: root.primary ? #06231f : root.danger ? #ffd3d6 : Palette.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 600;
        font-size: 14px;
        overflow: elide;
    }

    TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    width: Math.max(56px, small-label.preferred-width + 22px);
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.danger ? Palette.danger-soft : Palette.surface-alt;
    border-width: 1px;
    border-color: root.danger ? #7f2b34 : Palette.border;

    small-label := Text {
        text: root.label;
        color: root.danger ? #ffd3d6 : Palette.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 600;
    }

    TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;

    height: 34px;
    width: Math.max(50px, chip-label.preferred-width + 24px);
    border-radius: 17px;
    background: root.selected ? Palette.accent-soft : Palette.surface-alt;
    border-width: 1px;
    border-color: root.selected ? Palette.accent : Palette.border;

    chip-label := Text {
        text: root.label;
        color: root.selected ? Palette.accent : Palette.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px;
        font-weight: 600;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component FieldInput inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <string> hint: "";
    in-out property <string> value;
    in property <bool> read-only: false;
    in property <InputType> input-type: InputType.text;
    in property <length> editor-height: 42px;

    spacing: 5px;

    Text {
        text: root.label;
        color: Palette.muted;
        font-size: 12px;
        font-weight: 600;
    }

    Rectangle {
        height: root.editor-height;
        background: Palette.surface-alt;
        border-radius: 9px;
        border-width: 1px;
        border-color: input.has-focus ? Palette.accent : Palette.border;
        clip: true;

        if input.text == "" : Text {
            x: 11px;
            width: parent.width - 22px;
            height: parent.height;
            text: root.placeholder;
            color: #667389;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }

        input := TextInput {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            text <=> root.value;
            color: Palette.text;
            font-size: 14px;
            vertical-alignment: center;
            single-line: true;
            read-only: root.read-only;
            input-type: root.input-type;
        }
    }

    if root.hint != "" : Text {
        text: root.hint;
        color: #667389;
        font-size: 11px;
        wrap: word-wrap;
    }
}

component StatCard inherits Card {
    in property <string> title;
    in property <string> value;
    in property <string> detail: "";

    height: 72px;

    VerticalLayout {
        padding: 11px;
        spacing: 3px;

        Text {
            text: root.title;
            color: Palette.muted;
            font-size: 11px;
            font-weight: 600;
            overflow: elide;
        }

        Text {
            text: root.value;
            color: Palette.text;
            font-size: 18px;
            font-weight: 700;
            overflow: elide;
        }

        if root.detail != "" : Text {
            text: root.detail;
            color: #667389;
            font-size: 10px;
            overflow: elide;
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in-out property <bool> checked;
    callback toggled;

    height: 40px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;

        VerticalLayout {
            alignment: start;
            spacing: 1px;

            Text {
                text: root.label;
                color: Palette.text;
                font-size: 13px;
                vertical-alignment: center;
            }

            if root.hint != "" : Text {
                text: root.hint;
                color: #667389;
                font-size: 10px;
                overflow: elide;
            }
        }

        Rectangle {
            width: 44px;
            height: 24px;
            border-radius: 12px;
            background: root.checked ? Palette.accent : Palette.surface-alt;
            border-width: 1px;
            border-color: root.checked ? Palette.accent : Palette.border;

            Rectangle {
                x: root.checked ? 22px : 3px;
                y: 3px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: root.checked ? #06231f : Palette.muted;
            }
        }
    }

    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;

    horizontal-stretch: 1;
    height: 48px;
    border-radius: 10px;
    background: root.active ? Palette.accent-soft : transparent;

    Text {
        text: root.label;
        color: root.active ? Palette.accent : Palette.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 11px;
        font-weight: 600;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component OverlayHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle: "";
    callback closed;

    spacing: 8px;
    alignment: start;

    VerticalLayout {
        spacing: 2px;

        Text {
            text: root.title;
            color: Palette.text;
            font-size: 19px;
            font-weight: 700;
            overflow: elide;
        }

        if root.subtitle != "" : Text {
            text: root.subtitle;
            color: Palette.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    SmallButton {
        label: "Close";
        clicked => {
            root.closed();
        }
    }
}

component NoData inherits Rectangle {
    in property <string> message;

    height: 68px;
    background: transparent;

    Text {
        text: root.message;
        color: Palette.muted;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component AppWindow inherits Window {
    title: "Workout Tracker";
    width: 430px;
    height: 900px;
    background: Palette.bg;
    default-font-size: 14px;

    // ---------------------------------------------------------------------
    // General state
    // ---------------------------------------------------------------------
    in-out property <int> active-tab: 0;
    in-out property <string> status-message;
    in-out property <bool> status-error: false;
    in-out property <string> fatal-error;

    // ---------------------------------------------------------------------
    // Workout
    // ---------------------------------------------------------------------
    in-out property <string> workout-date;
    in-out property <string> workout-date-label;
    in-out property <string> workout-summary;
    in-out property <[WorkoutSetRow]> workout-sets;
    in-out property <bool> workout-empty: true;

    in-out property <bool> set-form-visible;
    in-out property <string> set-form-title: "Add set";
    in-out property <bool> set-form-editing: false;
    in-out property <string> set-exercise-name: "Choose exercise";
    in-out property <string> set-equipment-name: "Choose equipment";
    in-out property <string> set-weight: "";
    in-out property <string> set-complete-reps: "";
    in-out property <string> set-partial-reps: "";
    in-out property <string> set-rest: "";
    in-out property <string> set-rir: "";
    in-out property <string> set-extra: "";
    in-out property <string> set-form-error;

    // ---------------------------------------------------------------------
    // History
    // ---------------------------------------------------------------------
    in-out property <[HistoryRow]> history-rows;
    in-out property <bool> history-empty: true;

    // ---------------------------------------------------------------------
    // Analytics
    // ---------------------------------------------------------------------
    in-out property <string> analytics-period-key: "30";
    in-out property <string> analytics-period-label: "Last 30 days";
    in-out property <string> analytics-range;
    in-out property <string> analytics-exercise: "Exercise: any";
    in-out property <string> analytics-muscle: "Muscle: any";
    in-out property <string> analytics-total-sets: "0";
    in-out property <string> analytics-total-reps: "0";
    in-out property <string> analytics-total-volume: "0 kg";
    in-out property <string> analytics-max-weight: "-";
    in-out property <string> analytics-average-weight: "-";
    in-out property <string> analytics-average-rir: "-";
    in-out property <string> analytics-chart: "weight";
    in-out property <string> analytics-chart-title: "Weight progression";
    in-out property <string> analytics-chart-caption-start;
    in-out property <string> analytics-chart-caption-end;
    in-out property <image> chart-image;
    in-out property <bool> chart-empty: true;
    in-out property <[NamedValueRow]> chart-bars;
    in-out property <string> chart-bars-title;
    in-out property <[MuscleStatRow]> analytics-muscles;
    in-out property <bool> analytics-muscles-empty: true;
    in-out property <bool> analytics-has-data: false;

    in-out property <bool> custom-period-visible;
    in-out property <string> custom-period-start;
    in-out property <string> custom-period-end;
    in-out property <string> custom-period-error;

    // ---------------------------------------------------------------------
    // Library
    // ---------------------------------------------------------------------
    in-out property <int> library-tab: 0;
    in-out property <string> library-search;
    in-out property <[LibraryRow]> library-rows;
    in-out property <bool> library-empty: true;

    in-out property <bool> exercise-editor-visible;
    in-out property <string> exercise-editor-title: "Exercise";
    in-out property <string> exercise-editor-name;
    in-out property <string> exercise-editor-description;
    in-out property <string> exercise-editor-category: "Other";
    in-out property <bool> exercise-editor-active: true;
    in-out property <[AssignmentRow]> exercise-editor-assignments;
    in-out property <string> exercise-editor-error;

    in-out property <bool> muscle-editor-visible;
    in-out property <string> muscle-editor-title: "Muscle group";
    in-out property <string> muscle-editor-name;
    in-out property <string> muscle-editor-description;
    in-out property <bool> muscle-editor-active: true;
    in-out property <string> muscle-editor-error;

    in-out property <bool> equipment-editor-visible;
    in-out property <string> equipment-editor-title: "Equipment";
    in-out property <string> equipment-editor-name;
    in-out property <string> equipment-editor-category;
    in-out property <bool> equipment-editor-active: true;
    in-out property <bool> equipment-editor-reserved: false;
    in-out property <string> equipment-editor-error;

    // ---------------------------------------------------------------------
    // Profile
    // ---------------------------------------------------------------------
    in-out property <string> profile-name: "Athlete";
    in-out property <string> profile-height: "-";
    in-out property <string> profile-dob: "-";
    in-out property <string> profile-latest-date: "No measurements yet";
    in-out property <string> profile-weight: "-";
    in-out property <string> profile-bmi: "-";
    in-out property <string> profile-bmi-category;
    in-out property <string> profile-body-fat: "-";
    in-out property <string> profile-waist: "-";
    in-out property <string> profile-chest: "-";
    in-out property <string> profile-arm: "-";
    in-out property <string> profile-thigh: "-";
    in-out property <[ComparisonRow]> profile-comparisons;
    in-out property <[MeasurementRow]> profile-measurements;
    in-out property <bool> profile-measurements-empty: true;

    in-out property <bool> profile-edit-visible;
    in-out property <string> profile-edit-name;
    in-out property <string> profile-edit-height;
    in-out property <string> profile-edit-dob;
    in-out property <string> profile-edit-error;

    in-out property <bool> measurement-form-visible;
    in-out property <string> measurement-date;
    in-out property <string> measurement-weight;
    in-out property <string> measurement-height;
    in-out property <string> measurement-body-fat;
    in-out property <string> measurement-waist;
    in-out property <string> measurement-chest;
    in-out property <string> measurement-hip;
    in-out property <string> measurement-arm;
    in-out property <string> measurement-thigh;
    in-out property <string> measurement-notes;
    in-out property <string> measurement-error;

    in-out property <string> update-installed: "-";
    in-out property <string> update-latest: "-";
    in-out property <string> update-status: "Not checked yet";
    in-out property <string> update-notes;
    in-out property <string> update-config-path;
    in-out property <string> update-last-checked;
    in-out property <float> update-progress: 0;
    in-out property <string> update-progress-label;
    in-out property <bool> update-running: false;
    in-out property <bool> update-can-download: false;
    in-out property <bool> update-can-install: false;
    in-out property <bool> update-can-download-rollback: false;
    in-out property <bool> update-can-install-rollback: false;
    in-out property <string> update-staged;
    in-out property <string> update-backup;

    // ---------------------------------------------------------------------
    // Picker
    // ---------------------------------------------------------------------
    in-out property <bool> picker-visible;
    in-out property <string> picker-title: "Select";
    in-out property <[PickerRow]> picker-rows;
    in-out property <string> picker-search;
    in-out property <bool> picker-can-create: false;
    in-out property <string> picker-create-label: "Create";
    in-out property <string> picker-error;
    in-out property <bool> picker-empty: true;

    // ---------------------------------------------------------------------
    // Confirmation
    // ---------------------------------------------------------------------
    in-out property <bool> confirm-visible;
    in-out property <string> confirm-title: "Are you sure?";
    in-out property <string> confirm-message;
    in-out property <string> confirm-label: "Confirm";

    // ---------------------------------------------------------------------
    // Callbacks
    // ---------------------------------------------------------------------
    callback tab-changed(int);
    callback set-workout-date();
    callback workout-today();
    callback open-add-set();
    callback open-edit-set(int);
    callback request-delete-set(int);
    callback save-set();
    callback cancel-set-form();
    callback pick-set-exercise();
    callback pick-set-equipment();

    callback select-history-day(string);

    callback select-period(string);
    callback open-custom-period();
    callback apply-custom-period();
    callback cancel-custom-period();
    callback select-chart(string);
    callback pick-analytics-exercise();
    callback pick-analytics-muscle();

    callback select-library-tab(int);
    callback library-search-edited(string);
    callback open-add-library();
    callback open-edit-library(int);
    callback toggle-library-active(int);
    callback save-exercise-editor();
    callback cancel-exercise-editor();
    callback set-exercise-category(string);
    callback add-exercise-muscle(string);
    callback toggle-exercise-muscle(int);
    callback remove-exercise-muscle(int);
    callback save-muscle-editor();
    callback cancel-muscle-editor();
    callback save-equipment-editor();
    callback cancel-equipment-editor();

    callback open-profile-edit();
    callback save-profile();
    callback cancel-profile-edit();
    callback open-measurement-form();
    callback save-measurement();
    callback cancel-measurement-form();
    callback check-updates();
    callback download-update();
    callback install-update();
    callback download-rollback();
    callback install-rollback();
    callback poll-updates();

    callback picker-search-edited(string);
    callback picker-select(int);
    callback picker-create(string);
    callback picker-cancel();

    callback confirm-yes();
    callback confirm-no();

    // ---------------------------------------------------------------------
    // Main layout
    // ---------------------------------------------------------------------
    VerticalLayout {
        width: root.width;
        height: root.height;

        // Header
        Rectangle {
            height: 66px;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;

                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 12px;
                    background: Palette.accent;

                    Text {
                        text: "FAT";
                        color: #06231f;
                        font-size: 12px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 1px;
                    alignment: center;

                    Text {
                        text: "Workout Tracker";
                        color: Palette.text;
                        font-size: 16px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Local-first training log";
                        color: Palette.muted;
                        font-size: 11px;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: "v";
                    color: Palette.muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }

        // Content
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            // =============================================================
            // WORKOUT
            // =============================================================
            if root.active-tab == 0 : ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.width;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            spacing: 2px;

                            Text {
                                text: "Workout";
                                color: Palette.text;
                                font-size: 24px;
                                font-weight: 800;
                            }

                            Text {
                                text: root.workout-date-label;
                                color: Palette.muted;
                                font-size: 12px;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        SmallButton {
                            label: "Today";
                            clicked => {
                                root.workout-today();
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 42px;
                            background: Palette.surface-alt;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: Palette.border;

                            date-input := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text <=> root.workout-date;
                                color: Palette.text;
                                font-size: 14px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }

                        SmallButton {
                            label: "Load date";
                            clicked => {
                                root.set-workout-date();
                            }
                        }
                    }

                    Card {
                        height: 82px;

                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;

                                Text {
                                    text: root.workout-date-label;
                                    color: Palette.text;
                                    font-size: 15px;
                                    font-weight: 700;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.workout-summary;
                                    color: Palette.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }

                            ActionButton {
                                label: "Add set";
                                primary: true;
                                width: 104px;
                                clicked => {
                                    root.open-add-set();
                                }
                            }
                        }
                    }

                    if root.workout-empty : NoData {
                        message: "No sets recorded for this date. Add a set to start logging.";
                    }

                    for set-row[i] in root.workout-sets : Card {
                        height: set-content.preferred-height + 20px;

                        set-content := VerticalLayout {
                            padding: 12px;
                            spacing: 7px;

                            HorizontalLayout {
                                spacing: 9px;

                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 9px;
                                    background: Palette.accent-soft;

                                    Text {
                                        text: set-row.sequence;
                                        color: Palette.accent;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 2px;

                                    Text {
                                        text: set-row.title;
                                        color: Palette.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: set-row.detail;
                                        color: Palette.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: start;

                                    Text {
                                        text: set-row.volume;
                                        color: Palette.accent;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: right;
                                    }

                                    Text {
                                        text: set-row.equipment;
                                        color: #667389;
                                        font-size: 10px;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                }
                            }

                            if set-row.has-extra : HorizontalLayout {
                                spacing: 8px;

                                Rectangle {
                                    width: 31px;
                                    background: transparent;
                                }

                                Text {
                                    text: set-row.extra;
                                    color: #a7b4c6;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                SmallButton {
                                    label: "Edit";
                                    clicked => {
                                        root.open-edit-set(set-row.sequence);
                                    }
                                }

                                SmallButton {
                                    label: "Delete";
                                    danger: true;
                                    clicked => {
                                        root.request-delete-set(set-row.sequence);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // =============================================================
            // HISTORY
            // =============================================================
            if root.active-tab == 1 : ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.width;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    Text {
                        text: "History";
                        color: Palette.text;
                        font-size: 24px;
                        font-weight: 800;
                    }

                    Text {
                        text: "Every recorded training day, newest first. Select a day to view or edit its sets.";
                        color: Palette.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    if root.history-empty : NoData {
                        message: "No workout history yet.";
                    }

                    for history-row[i] in root.history-rows : Card {
                        height: history-content.preferred-height + 20px;

                        history-content := VerticalLayout {
                            padding: 13px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 8px;

                                VerticalLayout {
                                    spacing: 2px;

                                    Text {
                                        text: history-row.date_label;
                                        color: Palette.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: history-row.title;
                                        color: Palette.muted;
                                        font-size: 12px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                Text {
                                    text: history-row.volume;
                                    color: Palette.accent;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: history-row.detail;
                                color: #a7b4c6;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.select-history-day(history-row.date_key);
                            }
                        }
                    }
                }
            }

            // =============================================================
            // ANALYTICS
            // =============================================================
            if root.active-tab == 2 : ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.width;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    Text {
                        text: "Analytics";
                        color: Palette.text;
                        font-size: 24px;
                        font-weight: 800;
                    }

                    Text {
                        text: root.analytics-range;
                        color: Palette.muted;
                        font-size: 12px;
                    }

                    HorizontalLayout {
                        spacing: 7px;
                        Chip { label: "7d"; selected: root.analytics-period-key == "7"; clicked => { root.select-period("7"); } }
                        Chip { label: "30d"; selected: root.analytics-period-key == "30"; clicked => { root.select-period("30"); } }
                        Chip { label: "90d"; selected: root.analytics-period-key == "90"; clicked => { root.select-period("90"); } }
                        Chip { label: "6m"; selected: root.analytics-period-key == "6m"; clicked => { root.select-period("6m"); } }
                        Chip { label: "12m"; selected: root.analytics-period-key == "12m"; clicked => { root.select-period("12m"); } }
                        Chip { label: "All"; selected: root.analytics-period-key == "all"; clicked => { root.select-period("all"); } }
                    }

                    HorizontalLayout {
                        spacing: 7px;
                        Chip {
                            label: "Custom range";
                            selected: root.analytics-period-key == "custom";
                            clicked => { root.open-custom-period(); }
                        }
                        Text {
                            text: root.analytics-period-label;
                            color: Palette.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        ActionButton {
                            label: root.analytics-exercise;
                            horizontal-stretch: 1;
                            clicked => { root.pick-analytics-exercise(); }
                        }

                        ActionButton {
                            label: root.analytics-muscle;
                            horizontal-stretch: 1;
                            clicked => { root.pick-analytics-muscle(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 9px;
                        StatCard { title: "Total sets"; value: root.analytics-total-sets; horizontal-stretch: 1; }
                        StatCard { title: "Effective reps"; value: root.analytics-total-reps; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        StatCard { title: "Volume"; value: root.analytics-total-volume; horizontal-stretch: 1; }
                        StatCard { title: "Heaviest set"; value: root.analytics-max-weight; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        StatCard { title: "Average weight"; value: root.analytics-average-weight; horizontal-stretch: 1; }
                        StatCard { title: "Average RIR"; value: root.analytics-average-rir; horizontal-stretch: 1; }
                    }

                    if !root.analytics-has-data : NoData {
                        message: "No actual records match this period and filter selection.";
                    }

                    HorizontalLayout {
                        spacing: 7px;
                        Chip { label: "Weight"; selected: root.analytics-chart == "weight"; clicked => { root.select-chart("weight"); } }
                        Chip { label: "Volume"; selected: root.analytics-chart == "volume"; clicked => { root.select-chart("volume"); } }
                        Chip { label: "Weekly"; selected: root.analytics-chart == "weekly-volume"; clicked => { root.select-chart("weekly-volume"); } }
                        Chip { label: "Muscle"; selected: root.analytics-chart == "muscle"; clicked => { root.select-chart("muscle"); } }
                        Chip { label: "Frequency"; selected: root.analytics-chart == "frequency"; clicked => { root.select-chart("frequency"); } }
                    }

                    Card {
                        height: 286px;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: root.analytics-chart-title;
                                color: Palette.text;
                                font-size: 14px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            if root.chart-empty : NoData {
                                message: "No chart data for this selection.";
                            }

                            if !root.chart-empty : Image {
                                source: root.chart-image;
                                height: 172px;
                                image-fit: contain;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: root.analytics-chart-caption-start;
                                    color: Palette.muted;
                                    font-size: 10px;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                Text {
                                    text: root.analytics-chart-caption-end;
                                    color: Palette.muted;
                                    font-size: 10px;
                                }
                            }

                            if root.chart-bars-title != "" : Text {
                                text: root.chart-bars-title;
                                color: Palette.muted;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            for bar[i] in root.chart-bars : HorizontalLayout {
                                height: 20px;
                                spacing: 8px;

                                Text {
                                    text: bar.label;
                                    color: Palette.text;
                                    font-size: 11px;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: bar.value;
                                    color: Palette.accent;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: "Muscle attribution";
                        color: Palette.text;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Primary involvement receives full set volume; secondary involvement receives half. Sets are counted separately.";
                        color: Palette.muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    if root.analytics-muscles-empty : NoData {
                        message: "No muscle-groups were involved in this selection.";
                    }

                    for muscle-row[i] in root.analytics-muscles : Card {
                        height: muscle-content.preferred-height + 18px;

                        muscle-content := VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            Text {
                                text: muscle-row.name;
                                color: Palette.text;
                                font-size: 14px;
                                font-weight: 700;
                            }

                            Text {
                                text: muscle-row.sets;
                                color: Palette.muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: muscle-row.primary;
                                color: #a7b4c6;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: muscle-row.secondary;
                                color: #a7b4c6;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: muscle-row.total;
                                color: Palette.accent;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }
                    }
                }
            }

            // =============================================================
            // LIBRARY
            // =============================================================
            if root.active-tab == 3 : ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.width;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Library";
                            color: Palette.text;
                            font-size: 24px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        ActionButton {
                            label: root.library-tab == 0 ? "New exercise" : root.library-tab == 1 ? "New muscle" : "New equipment";
                            primary: true;
                            width: 128px;
                            clicked => { root.open-add-library(); }
                        }
                    }

                    Text {
                        text: "Reference records are archived instead of deleted so historical sets always remain readable.";
                        color: Palette.muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 7px;

                        Chip {
                            label: "Exercises";
                            selected: root.library-tab == 0;
                            clicked => { root.select-library-tab(0); }
                        }
                        Chip {
                            label: "Muscles";
                            selected: root.library-tab == 1;
                            clicked => { root.select-library-tab(1); }
                        }
                        Chip {
                            label: "Equipment";
                            selected: root.library-tab == 2;
                            clicked => { root.select-library-tab(2); }
                        }
                    }

                    Rectangle {
                        height: 42px;
                        background: Palette.surface-alt;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Palette.border;

                        if library-search-input.text == "" : Text {
                            x: 11px;
                            width: parent.width - 22px;
                            height: parent.height;
                            text: "Search name or description";
                            color: #667389;
                            font-size: 14px;
                            vertical-alignment: center;
                        }

                        library-search-input := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text <=> root.library-search;
                            color: Palette.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            single-line: true;
                            edited => {
                                root.library-search-edited(root.library-search);
                            }
                        }
                    }

                    if root.library-empty : NoData {
                        message: "Nothing matches this search.";
                    }

                    for library-row[i] in root.library-rows : Card {
                        height: library-content.preferred-height + 18px;

                        library-content := VerticalLayout {
                            padding: 12px;
                            spacing: 7px;

                            HorizontalLayout {
                                spacing: 8px;

                                VerticalLayout {
                                    spacing: 2px;

                                    Text {
                                        text: library-row.title;
                                        color: Palette.text;
                                        font-size: 14px;
                                        font-weight: 700;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: library-row.subtitle;
                                        color: Palette.muted;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                Rectangle {
                                    height: 24px;
                                    width: Math.max(52px, badge-text.preferred-width + 16px);
                                    border-radius: 12px;
                                    background: library-row.is_active ? Palette.accent-soft : Palette.surface-alt;
                                    border-width: 1px;
                                    border-color: library-row.is_active ? Palette.accent : Palette.border;

                                    badge-text := Text {
                                        text: library-row.badge;
                                        color: library-row.is_active ? Palette.accent : Palette.muted;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                SmallButton {
                                    label: "Edit";
                                    clicked => {
                                        root.open-edit-library(library-row.id);
                                    }
                                }

                                SmallButton {
                                    label: library-row.toggle_label;
                                    enabled: library-row.can_toggle;
                                    danger: library-row.is_active;
                                    clicked => {
                                        root.toggle-library-active(library-row.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // =============================================================
            // PROFILE
            // =============================================================
            if root.active-tab == 4 : ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.width;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    Text {
                        text: "Profile";
                        color: Palette.text;
                        font-size: 24px;
                        font-weight: 800;
                    }

                    Card {
                        height: 108px;

                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;

                            Rectangle {
                                width: 52px;
                                height: 52px;
                                border-radius: 16px;
                                background: Palette.accent-soft;

                                Text {
                                    text: "P";
                                    color: Palette.accent;
                                    font-size: 22px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: root.profile-name;
                                    color: Palette.text;
                                    font-size: 19px;
                                    font-weight: 800;
                                    overflow: elide;
                                }

                                Text {
                                    text: "Height " + root.profile-height + "   |   Born " + root.profile-dob;
                                    color: Palette.muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: root.profile-latest-date;
                                    color: #667389;
                                    font-size: 10px;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }

                            SmallButton {
                                label: "Edit profile";
                                clicked => { root.open-profile-edit(); }
                            }
                        }
                    }

                    Text {
                        text: "Latest measurements";
                        color: Palette.text;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 9px;
                        StatCard { title: "Weight"; value: root.profile-weight; horizontal-stretch: 1; }
                        StatCard { title: "BMI"; value: root.profile-bmi; detail: root.profile-bmi-category; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        StatCard { title: "Body fat"; value: root.profile-body-fat; horizontal-stretch: 1; }
                        StatCard { title: "Waist"; value: root.profile-waist; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        StatCard { title: "Chest"; value: root.profile-chest; horizontal-stretch: 1; }
                        StatCard { title: "Arm"; value: root.profile-arm; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        StatCard { title: "Thigh"; value: root.profile-thigh; horizontal-stretch: 1; }
                        StatCard { title: "Snapshots"; value: root.profile-measurements-empty ? "0" : root.profile-latest-date; horizontal-stretch: 1; }
                    }

                    Text {
                        text: "Changes since previous observation";
                        color: Palette.text;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    Card {
                        height: comparison-content.preferred-height + 18px;

                        comparison-content := VerticalLayout {
                            padding: 12px;
                            spacing: 7px;

                            for comparison[i] in root.profile-comparisons : HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: comparison.label;
                                    color: Palette.muted;
                                    font-size: 11px;
                                    width: 92px;
                                    overflow: elide;
                                }

                                Text {
                                    text: comparison.current;
                                    color: Palette.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 84px;
                                }

                                Text {
                                    text: comparison.delta;
                                    color: comparison.has_delta ? Palette.accent : Palette.muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                    width: 72px;
                                }

                                Text {
                                    text: comparison.dates;
                                    color: #667389;
                                    font-size: 10px;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Measurement history";
                            color: Palette.text;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        SmallButton {
                            label: "Add snapshot";
                            clicked => { root.open-measurement-form(); }
                        }
                    }

                    Text {
                        text: "Snapshots are append-only. BMI is only derived from weight and height recorded in the same snapshot.";
                        color: Palette.muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    if root.profile-measurements-empty : NoData {
                        message: "No body measurements recorded yet.";
                    }

                    for measurement-row[i] in root.profile-measurements : Card {
                        height: measurement-content.preferred-height + 18px;

                        measurement-content := VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            Text {
                                text: measurement-row.title;
                                color: Palette.text;
                                font-size: 13px;
                                font-weight: 700;
                            }

                            Text {
                                text: measurement-row.detail;
                                color: Palette.muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            if measurement-row.has_notes : Text {
                                text: measurement-row.notes;
                                color: #a7b4c6;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Text {
                        text: "Application updates";
                        color: Palette.text;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    Card {
                        height: update-content.preferred-height + 20px;

                        update-content := VerticalLayout {
                            padding: 13px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: "Installed";
                                    color: Palette.muted;
                                    font-size: 11px;
                                }

                                Text {
                                    text: root.update-installed;
                                    color: Palette.text;
                                    font-size: 11px;
                                    font-weight: 600;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                Text {
                                    text: "Latest";
                                    color: Palette.muted;
                                    font-size: 11px;
                                }

                                Text {
                                    text: root.update-latest;
                                    color: Palette.text;
                                    font-size: 11px;
                                    font-weight: 600;
                                }
                            }

                            Text {
                                text: root.update-status;
                                color: Palette.text;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            if root.update-notes != "" : Text {
                                text: root.update-notes;
                                color: Palette.muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            if root.update-staged != "" : Text {
                                text: root.update-staged;
                                color: #a7b4c6;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            if root.update-backup != "" : Text {
                                text: root.update-backup;
                                color: #a7b4c6;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            if root.update-running : Rectangle {
                                height: 8px;
                                border-radius: 4px;
                                background: Palette.surface-alt;

                                Rectangle {
                                    width: parent.width * Math.min(1, Math.max(0, root.update-progress));
                                    height: parent.height;
                                    border-radius: 4px;
                                    background: Palette.accent;
                                }
                            }

                            if root.update-progress-label != "" : Text {
                                text: root.update-progress-label;
                                color: Palette.muted;
                                font-size: 10px;
                            }

                            HorizontalLayout {
                                spacing: 7px;

                                SmallButton {
                                    label: "Check";
                                    enabled: !root.update-running;
                                    clicked => { root.check-updates(); }
                                }

                                SmallButton {
                                    label: "Download";
                                    enabled: !root.update-running && root.update-can-download;
                                    clicked => { root.download-update(); }
                                }

                                SmallButton {
                                    label: "Install staged";
                                    enabled: !root.update-running && root.update-can-install;
                                    clicked => { root.install-update(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 7px;

                                SmallButton {
                                    label: "Download rollback";
                                    enabled: !root.update-running && root.update-can-download-rollback;
                                    clicked => { root.download-rollback(); }
                                }

                                SmallButton {
                                    label: "Install rollback";
                                    enabled: !root.update-running && root.update-can-install-rollback;
                                    clicked => { root.install-rollback(); }
                                }
                            }

                            Text {
                                text: "Last checked: " + root.update-last-checked;
                                color: #667389;
                                font-size: 10px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Config: " + root.update-config-path;
                                color: #667389;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // Tab bar
        Rectangle {
            height: 62px;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding: 7px;
                spacing: 5px;

                TabButton {
                    label: "Workout";
                    active: root.active-tab == 0;
                    clicked => { root.active-tab = 0; root.tab-changed(0); }
                }
                TabButton {
                    label: "History";
                    active: root.active-tab == 1;
                    clicked => { root.active-tab = 1; root.tab-changed(1); }
                }
                TabButton {
                    label: "Analytics";
                    active: root.active-tab == 2;
                    clicked => { root.active-tab = 2; root.tab-changed(2); }
                }
                TabButton {
                    label: "Library";
                    active: root.active-tab == 3;
                    clicked => { root.active-tab = 3; root.tab-changed(3); }
                }
                TabButton {
                    label: "Profile";
                    active: root.active-tab == 4;
                    clicked => { root.active-tab = 4; root.tab-changed(4); }
                }
            }
        }
    }

    // =========================================================================
    // Set form dialog
    // =========================================================================
    if root.set-form-visible : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000aa;

        Rectangle {
            x: 12px;
            y: 12px;
            width: root.width - 24px;
            height: root.height - 24px;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 16px;
                spacing: 11px;

                OverlayHeader {
                    title: root.set-form-title;
                    subtitle: root.set-form-editing
                        ? "Editing an existing set keeps its date and position."
                        : "The date is taken from the workout screen.";
                    closed => { root.cancel-set-form(); }
                }

                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;

                    VerticalLayout {
                        spacing: 11px;

                        ActionButton {
                            label: root.set-exercise-name;
                            clicked => { root.pick-set-exercise(); }
                        }

                        ActionButton {
                            label: root.set-equipment-name;
                            clicked => { root.pick-set-equipment(); }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            FieldInput {
                                label: "Weight (kg)";
                                placeholder: "0";
                                value <=> root.set-weight;
                                input-type: InputType.decimal;
                                hint: "Use 0 for bodyweight";
                                horizontal-stretch: 1;
                            }
                            FieldInput {
                                label: "Complete reps";
                                placeholder: "8";
                                value <=> root.set-complete-reps;
                                input-type: InputType.number;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            FieldInput {
                                label: "Partial reps";
                                placeholder: "0";
                                value <=> root.set-partial-reps;
                                input-type: InputType.number;
                                hint: "Each partial counts as half a rep";
                                horizontal-stretch: 1;
                            }
                            FieldInput {
                                label: "Rest (seconds)";
                                placeholder: "optional";
                                value <=> root.set-rest;
                                input-type: InputType.number;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            FieldInput {
                                label: "RIR (0-10)";
                                placeholder: "optional";
                                value <=> root.set-rir;
                                input-type: InputType.number;
                                horizontal-stretch: 1;
                            }
                            FieldInput {
                                label: "Extra information";
                                placeholder: "optional";
                                value <=> root.set-extra;
                                horizontal-stretch: 1;
                            }
                        }

                        if root.set-form-error != "" : Text {
                            text: root.set-form-error;
                            color: Palette.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                ActionButton {
                    label: root.set-form-editing ? "Save changes" : "Add set";
                    primary: true;
                    clicked => { root.save-set(); }
                }
            }
        }
    }

    // =========================================================================
    // Exercise editor dialog
    // =========================================================================
    if root.exercise-editor-visible : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000aa;

        Rectangle {
            x: 12px;
            y: 12px;
            width: root.width - 24px;
            height: root.height - 24px;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 16px;
                spacing: 11px;

                OverlayHeader {
                    title: root.exercise-editor-title;
                    subtitle: "Archive exercises instead of deleting them. Historical sets keep working.";
                    closed => { root.cancel-exercise-editor(); }
                }

                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;

                    VerticalLayout {
                        spacing: 11px;

                        FieldInput {
                            label: "Exercise name";
                            placeholder: "e.g. Incline Bench Press";
                            value <=> root.exercise-editor-name;
                        }

                        FieldInput {
                            label: "Description";
                            placeholder: "optional";
                            value <=> root.exercise-editor-description;
                        }

                        Text {
                            text: "Category";
                            color: Palette.muted;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 7px;
                            Chip {
                                label: "Compound";
                                selected: root.exercise-editor-category == "Compound";
                                clicked => { root.set-exercise-category("Compound"); }
                            }
                            Chip {
                                label: "Isolation";
                                selected: root.exercise-editor-category == "Isolation";
                                clicked => { root.set-exercise-category("Isolation"); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 7px;
                            Chip {
                                label: "Bodyweight";
                                selected: root.exercise-editor-category == "Bodyweight";
                                clicked => { root.set-exercise-category("Bodyweight"); }
                            }
                            Chip {
                                label: "Other";
                                selected: root.exercise-editor-category == "Other";
                                clicked => { root.set-exercise-category("Other"); }
                            }
                        }

                        ToggleRow {
                            label: "Exercise is active";
                            hint: "Inactive exercises cannot be used for new sets.";
                            checked: root.exercise-editor-active;
                            toggled => { root.exercise-editor-active = !root.exercise-editor-active; }
                        }

                        Text {
                            text: "Muscle involvement";
                            color: Palette.text;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        Text {
                            text: "Primary muscles receive full volume; secondary muscles receive half. Each muscle can be assigned only once.";
                            color: Palette.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        if root.exercise-editor-assignments.length == 0 : NoData {
                            message: "No muscle groups assigned yet.";
                        }

                        for assignment[i] in root.exercise-editor-assignments : Card {
                            height: 54px;

                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;

                                VerticalLayout {
                                    spacing: 1px;
                                    alignment: center;

                                    Text {
                                        text: assignment.name;
                                        color: Palette.text;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }

                                    Text {
                                        text: assignment.role;
                                        color: assignment.role_key == "primary" ? Palette.accent : Palette.warning;
                                        font-size: 10px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                SmallButton {
                                    label: "Role";
                                    clicked => { root.toggle-exercise-muscle(assignment.muscle_id); }
                                }

                                SmallButton {
                                    label: "Remove";
                                    danger: true;
                                    clicked => { root.remove-exercise-muscle(assignment.muscle_id); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            ActionButton {
                                label: "Add primary muscle";
                                horizontal-stretch: 1;
                                clicked => { root.add-exercise-muscle("primary"); }
                            }

                            ActionButton {
                                label: "Add secondary muscle";
                                horizontal-stretch: 1;
                                clicked => { root.add-exercise-muscle("secondary"); }
                            }
                        }

                        if root.exercise-editor-error != "" : Text {
                            text: root.exercise-editor-error;
                            color: Palette.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                ActionButton {
                    label: "Save exercise";
                    primary: true;
                    clicked => { root.save-exercise-editor(); }
                }
            }
        }
    }

    // =========================================================================
    // Muscle editor dialog
    // =========================================================================
    if root.muscle-editor-visible : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000aa;

        Rectangle {
            x: 12px;
            y: 12px;
            width: root.width - 24px;
            height: root.height - 24px;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 16px;
                spacing: 11px;

                OverlayHeader {
                    title: root.muscle-editor-title;
                    subtitle: "A muscle used by exercises cannot be deactivated until it is removed from those definitions.";
                    closed => { root.cancel-muscle-editor(); }
                }

                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;

                    VerticalLayout {
                        spacing: 11px;

                        FieldInput {
                            label: "Muscle group name";
                            placeholder: "e.g. Rear Delts";
                            value <=> root.muscle-editor-name;
                        }

                        FieldInput {
                            label: "Description";
                            placeholder: "optional";
                            value <=> root.muscle-editor-description;
                        }

                        ToggleRow {
                            label: "Muscle group is active";
                            hint: "Inactive groups cannot be assigned to exercises.";
                            checked: root.muscle-editor-active;
                            toggled => { root.muscle-editor-active = !root.muscle-editor-active; }
                        }

                        if root.muscle-editor-error != "" : Text {
                            text: root.muscle-editor-error;
                            color: Palette.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                ActionButton {
                    label: "Save muscle group";
                    primary: true;
                    clicked => { root.save-muscle-editor(); }
                }
            }
        }
    }

    // =========================================================================
    // Equipment editor dialog
    // =========================================================================
    if root.equipment-editor-visible : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000aa;

        Rectangle {
            x: 12px;
            y: 12px;
            width: root.width - 24px;
            height: root.height - 24px;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 16px;
                spacing: 11px;

                OverlayHeader {
                    title: root.equipment-editor-title;
                    subtitle: root.equipment-editor-reserved
                        ? "No Equipment is reserved: it must stay active and keep its name."
                        : "Equipment is archived rather than physically deleted.";
                    closed => { root.cancel-equipment-editor(); }
                }

                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;

                    VerticalLayout {
                        spacing: 11px;

                        FieldInput {
                            label: "Equipment name";
                            placeholder: "e.g. Trap Bar";
                            value <=> root.equipment-editor-name;
                            read-only: root.equipment-editor-reserved;
                        }

                        FieldInput {
                            label: "Category";
                            placeholder: "optional, e.g. Free weights";
                            value <=> root.equipment-editor-category;
                        }

                        ToggleRow {
                            label: "Equipment is active";
                            hint: root.equipment-editor-reserved
                                ? "This reserved record cannot be deactivated."
                                : "Inactive equipment cannot be used for new sets.";
                            checked: root.equipment-editor-active;
                            toggled => {
                                if (!root.equipment-editor-reserved) {
                                    root.equipment-editor-active = !root.equipment-editor-active;
                                }
                            }
                        }

                        if root.equipment-editor-error != "" : Text {
                            text: root.equipment-editor-error;
                            color: Palette.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                ActionButton {
                    label: "Save equipment";
                    primary: true;
                    clicked => { root.save-equipment-editor(); }
                }
            }
        }
    }

    // =========================================================================
    // Profile editor dialog
    // =========================================================================
    if root.profile-edit-visible : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000aa;

        Rectangle {
            x: 12px;
            y: 12px;
            width: root.width - 24px;
            height: root.height - 24px;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 16px;
                spacing: 11px;

                OverlayHeader {
                    title: "Edit profile";
                    subtitle: "Changing your profile does not alter historical measurement snapshots.";
                    closed => { root.cancel-profile-edit(); }
                }

                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;

                    VerticalLayout {
                        spacing: 11px;

                        FieldInput {
                            label: "Name";
                            placeholder: "Your name";
                            value <=> root.profile-edit-name;
                        }

                        FieldInput {
                            label: "Height (cm)";
                            placeholder: "optional";
                            value <=> root.profile-edit-height;
                            input-type: InputType.decimal;
                        }

                        FieldInput {
                            label: "Date of birth";
                            placeholder: "YYYY-MM-DD";
                            value <=> root.profile-edit-dob;
                        }

                        if root.profile-edit-error != "" : Text {
                            text: root.profile-edit-error;
                            color: Palette.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                ActionButton {
                    label: "Save profile";
                    primary: true;
                    clicked => { root.save-profile(); }
                }
            }
        }
    }

    // =========================================================================
    // Measurement form dialog
    // =========================================================================
    if root.measurement-form-visible : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000aa;

        Rectangle {
            x: 12px;
            y: 12px;
            width: root.width - 24px;
            height: root.height - 24px;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 16px;
                spacing: 11px;

                OverlayHeader {
                    title: "New measurement snapshot";
                    subtitle: "Snapshots are append-only. Fill in only the values you actually measured.";
                    closed => { root.cancel-measurement-form(); }
                }

                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;

                    VerticalLayout {
                        spacing: 10px;

                        FieldInput {
                            label: "Date";
                            placeholder: "YYYY-MM-DD";
                            value <=> root.measurement-date;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            FieldInput {
                                label: "Weight (kg)";
                                placeholder: "optional";
                                value <=> root.measurement-weight;
                                input-type: InputType.decimal;
                                horizontal-stretch: 1;
                            }
                            FieldInput {
                                label: "Height (cm)";
                                placeholder: "optional";
                                value <=> root.measurement-height;
                                input-type: InputType.decimal;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            FieldInput {
                                label: "Body fat (%)";
                                placeholder: "optional";
                                value <=> root.measurement-body-fat;
                                input-type: InputType.decimal;
                                horizontal-stretch: 1;
                            }
                            FieldInput {
                                label: "Waist (cm)";
                                placeholder: "optional";
                                value <=> root.measurement-waist;
                                input-type: InputType.decimal;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            FieldInput {
                                label: "Chest (cm)";
                                placeholder: "optional";
                                value <=> root.measurement-chest;
                                input-type: InputType.decimal;
                                horizontal-stretch: 1;
                            }
                            FieldInput {
                                label: "Hip (cm)";
                                placeholder: "optional";
                                value <=> root.measurement-hip;
                                input-type: InputType.decimal;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            FieldInput {
                                label: "Arm (cm)";
                                placeholder: "optional";
                                value <=> root.measurement-arm;
                                input-type: InputType.decimal;
                                horizontal-stretch: 1;
                            }
                            FieldInput {
                                label: "Thigh (cm)";
                                placeholder: "optional";
                                value <=> root.measurement-thigh;
                                input-type: InputType.decimal;
                                horizontal-stretch: 1;
                            }
                        }

                        FieldInput {
                            label: "Notes";
                            placeholder: "optional";
                            value <=> root.measurement-notes;
                        }

                        if root.measurement-error != "" : Text {
                            text: root.measurement-error;
                            color: Palette.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                ActionButton {
                    label: "Append snapshot";
                    primary: true;
                    clicked => { root.save-measurement(); }
                }
            }
        }
    }

    // =========================================================================
    // Custom period dialog
    // =========================================================================
    if root.custom-period-visible : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000aa;

        Rectangle {
            x: 24px;
            y: (root.height - 300px) / 2;
            width: root.width - 48px;
            height: 300px;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 16px;
                spacing: 11px;

                OverlayHeader {
                    title: "Custom range";
                    subtitle: "Both dates are inclusive.";
                    closed => { root.cancel-custom-period(); }
                }

                FieldInput {
                    label: "Start date";
                    placeholder: "YYYY-MM-DD";
                    value <=> root.custom-period-start;
                }

                FieldInput {
                    label: "End date";
                    placeholder: "YYYY-MM-DD";
                    value <=> root.custom-period-end;
                }

                if root.custom-period-error != "" : Text {
                    text: root.custom-period-error;
                    color: Palette.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                ActionButton {
                    label: "Apply range";
                    primary: true;
                    clicked => { root.apply-custom-period(); }
                }
            }
        }
    }

    // =========================================================================
    // Picker dialog
    // =========================================================================
    if root.picker-visible : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000aa;

        Rectangle {
            x: 14px;
            y: 40px;
            width: root.width - 28px;
            height: root.height - 80px;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                OverlayHeader {
                    title: root.picker-title;
                    closed => { root.picker-cancel(); }
                }

                Rectangle {
                    height: 40px;
                    background: Palette.surface-alt;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Palette.border;

                    if picker-search-input.text == "" : Text {
                        x: 11px;
                        width: parent.width - 22px;
                        height: parent.height;
                        text: "Search";
                        color: #667389;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    picker-search-input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text <=> root.picker-search;
                        color: Palette.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        single-line: true;
                        edited => {
                            root.picker-search-edited(root.picker-search);
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;

                    VerticalLayout {
                        spacing: 7px;

                        if root.picker-empty : NoData {
                            message: "No matching records.";
                        }

                        for picker-row[i] in root.picker-rows : Rectangle {
                            height: 54px;
                            border-radius: 9px;
                            background: picker-row.is_none ? Palette.accent-soft : Palette.surface-alt;
                            border-width: 1px;
                            border-color: picker-row.is_none ? Palette.accent : Palette.border;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                VerticalLayout {
                                    spacing: 1px;
                                    alignment: center;

                                    Text {
                                        text: picker-row.title;
                                        color: picker-row.is_none ? Palette.accent : Palette.text;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }

                                    if picker-row.subtitle != "" : Text {
                                        text: picker-row.subtitle;
                                        color: Palette.muted;
                                        font-size: 10px;
                                        overflow: elide;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                Text {
                                    text: "Select";
                                    color: Palette.accent;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.picker-select(picker-row.id); }
                            }
                        }
                    }
                }

                if root.picker-can-create : Rectangle {
                    height: 106px;
                    background: transparent;

                    VerticalLayout {
                        spacing: 7px;

                        Text {
                            text: "Create a new record";
                            color: Palette.muted;
                            font-size: 11px;
                            font-weight: 600;
                        }

                        Rectangle {
                            height: 40px;
                            background: Palette.surface-alt;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: Palette.border;

                            picker-create-input := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                color: Palette.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }

                        ActionButton {
                            label: root.picker-create-label;
                            height: 38px;
                            clicked => {
                                root.picker-create(picker-create-input.text);
                                picker-create-input.text = "";
                            }
                        }
                    }
                }

                if root.picker-error != "" : Text {
                    text: root.picker-error;
                    color: Palette.danger;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }

    // =========================================================================
    // Confirm dialog
    // =========================================================================
    if root.confirm-visible : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000aa;

        Rectangle {
            x: 24px;
            y: (root.height - 240px) / 2;
            width: root.width - 48px;
            height: 240px;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: root.confirm-title;
                    color: Palette.text;
                    font-size: 18px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                Text {
                    text: root.confirm-message;
                    color: Palette.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 9px;

                    ActionButton {
                        label: "Cancel";
                        horizontal-stretch: 1;
                        clicked => { root.confirm-no(); }
                    }

                    ActionButton {
                        label: root.confirm-label;
                        danger: true;
                        horizontal-stretch: 1;
                        clicked => { root.confirm-yes(); }
                    }
                }
            }
        }
    }

    // =========================================================================
    // Fatal startup error
    // =========================================================================
    if root.fatal-error != "" : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Palette.bg;

        VerticalLayout {
            padding: 28px;
            spacing: 14px;

            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                background: Palette.danger-soft;

                Text {
                    text: "!";
                    color: Palette.danger;
                    font-size: 24px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "The workout tracker could not start";
                color: Palette.text;
                font-size: 22px;
                font-weight: 800;
                wrap: word-wrap;
            }

            Text {
                text: root.fatal-error;
                color: Palette.muted;
                font-size: 13px;
                wrap: word-wrap;
            }

            Text {
                text: "Your data was not modified by this failure. Check the data directory permissions and configuration, then restart the application.";
                color: #667389;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }

    // =========================================================================
    // Toast
    // =========================================================================
    if root.status-message != "" : Rectangle {
        x: 16px;
        y: root.height - 86px;
        width: root.width - 32px;
        height: 50px;
        border-radius: 12px;
        background: root.status-error ? #4a1d22f2 : #143b38f2;
        border-width: 1px;
        border-color: root.status-error ? #7f2b34 : Palette.accent;

        Text {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.status-message;
            color: root.status-error ? #ffd3d6 : Palette.text;
            font-size: 12px;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        TouchArea {
            clicked => {
                root.status-message = "";
            }
        }
    }

    Timer {
        interval: 4s;
        running: root.status-message != "";
        triggered => {
            root.status-message = "";
        }
    }

    Timer {
        interval: 200ms;
        running: root.update-running;
        triggered => {
            root.poll-updates();
        }
    }
}
